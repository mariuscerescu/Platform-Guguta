# Platforma Guguță — configurație de dezvoltare (fără secrete reale, R08).
# Copiază în .env.guguta și ajustează. Staging/production refuză valorile
# implicite de dezvoltare (open_notebook.database.guguta.config.GugutaConfig).

# --- Mediu ---
GUGUTA_ENVIRONMENT=development
# development/ci acceptă și autentificarea sintetică de test; staging/production
# refuză GUGUTA_AUTH_MODE=test. Pentru MVP folosim email + parolă.
GUGUTA_AUTH_MODE=password

# --- Baze de date (roluri separate, ADR-0007) ---
# Migrator: doar jobul unic de release / testele de migrare.
# (127.0.0.1 în loc de localhost: pe unele setupuri Windows, rezolvarea IPv6
# a numelui blochează conexiunea — R08/R69 păstrează portul doar local.)
GUGUTA_DATABASE_URL_MIGRATOR=postgresql+psycopg://guguta_migrator:guguta_dev_migrator@127.0.0.1:5433/guguta
# Runtime API:
GUGUTA_DATABASE_URL_API=postgresql+psycopg://guguta_api:guguta_dev_api@127.0.0.1:5433/guguta
# Runtime worker:
GUGUTA_DATABASE_URL_WORKER=postgresql+psycopg://guguta_worker:guguta_dev_worker@127.0.0.1:5433/guguta

GUGUTA_DB_POOL_SIZE=5
GUGUTA_DB_MAX_OVERFLOW=10
GUGUTA_DB_POOL_TIMEOUT_SECONDS=30

# --- Stocare privată (ADR-0004) ---
GUGUTA_STORAGE_ROOT=./guguta_storage

# --- Origine publică / CORS ---
GUGUTA_PUBLIC_ORIGIN=http://localhost:3001
GUGUTA_CORS_ORIGINS=["http://localhost:3001", "http://localhost:3000", "http://127.0.0.1:3001", "http://127.0.0.1:3000"]

# --- Limite de lucru (de calibrat înainte de staging, GHID §10.2) ---
GUGUTA_MAX_UPLOAD_MIB=25
GUGUTA_MAX_IMAGE_PIXELS=20000000
GUGUTA_MAX_IMAGE_DIMENSION=8000
GUGUTA_CHAT_ATTACHMENT_MAX_MIB=25
GUGUTA_CHAT_ATTACHMENT_TOTAL_MIB=25
GUGUTA_CHAT_ATTACHMENT_MAX_PER_MESSAGE=5
GUGUTA_CHAT_ATTACHMENT_MAX_PER_SESSION=20
GUGUTA_MAX_PDF_PAGES=300
GUGUTA_MAX_SOURCES_PER_NOTEBOOK=20
GUGUTA_QUOTA_MIB_PER_USER=1024
GUGUTA_MAX_CONCURRENT_JOBS_PER_USER=2
GUGUTA_CHAT_TOTAL_TIMEOUT_SECONDS=120

# --- PDF: LiteParse nativ + PP-OCRv5 Mobile pe fiecare pagină ---
# În Docker folosește http://ppocr:8003; din workerul pornit direct
# pe gazdă, serviciul poate fi expus numai pe loopback la portul 8003.
GUGUTA_PDF_PARSER=liteparse_ppocr
GUGUTA_PPOCR_BASE_URL=http://host.docker.internal:8003
GUGUTA_PPOCR_TIMEOUT_SECONDS=120
GUGUTA_LITEPARSE_TIMEOUT_SECONDS=120
GUGUTA_PDF_OCR_DPI=120
GUGUTA_PDF_OCR_EVERY_PAGE=true
GUGUTA_PDF_OCR_COMPLEX_LAYOUT=false
GUGUTA_PDF_OCR_RENDER_BATCH_PAGES=10
GUGUTA_PDF_OCR_CONCURRENCY=10
GUGUTA_PPOCR_GPU=1
GUGUTA_PPOCR_MIN_CONFIDENCE=0.35

# --- Compose (doar valorile locale de dezvoltare) ---
# În staging/production: parole reale în secrets manager, niciodată în Git.
GUGUTA_PG_MIGRATOR_PASSWORD=guguta_dev_migrator
GUGUTA_PG_API_PASSWORD=guguta_dev_api
GUGUTA_PG_WORKER_PASSWORD=guguta_dev_worker

# --- Autentificare ---
# MVP: email + parolă. Pentru test automatizat se poate folosi GUGUTA_AUTH_MODE=test.
# Google/OIDC rămâne opțional pentru mai târziu.

# --- Furnizor OIDC (opțional) ---
# Google autentificare (OIDC). Activează cu GUGUTA_AUTH_MODE=oidc.
# În Google Cloud Console, adaugă redirect URI-ul exact prin frontend proxy:
# http://localhost:3001/guguta-api/api/v1/auth/oidc/callback
# GUGUTA_OIDC_ISSUER=https://accounts.google.com
# GUGUTA_OIDC_CLIENT_ID=<google-client-id>
# GUGUTA_OIDC_CLIENT_SECRET=<google-client-secret>
# GUGUTA_OIDC_REDIRECT_URI=http://localhost:3001/guguta-api/api/v1/auth/oidc/callback

# --- Furnizori AI (L4/L5; config centrally, chei în secrets manager) ---
# GUGUTA_AI_CHAT_MODEL=
# GUGUTA_AI_EMBEDDING_MODEL=

# --- OpenRouter (opt-in; .env.guguta.local este ignorat de Git) ---
# GUGUTA_OPENROUTER_API_KEY=<secret local>
# GUGUTA_CHAT_PROVIDER=openrouter
# GUGUTA_EMBEDDING_PROVIDER=local
# GUGUTA_EMBEDDING_DIMENSION=1024
# GUGUTA_RERANK_PROVIDER=local
# GUGUTA_LOCAL_RETRIEVAL_BASE_URL=http://qwen-retrieval:8002
# GUGUTA_LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# GUGUTA_LOCAL_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
# GUGUTA_LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# GUGUTA_LOCAL_RERANK_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473
# GUGUTA_OPENROUTER_CHAT_MODEL=minimax/minimax-m3:free
# GUGUTA_OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# GUGUTA_OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# GUGUTA_OPENROUTER_TIMEOUT_SECONDS=60
# GUGUTA_OPENROUTER_MAX_RETRIES=1
# GUGUTA_OPENROUTER_MAX_OUTPUT_TOKENS=3000

# --- Audio Overview (vocea rămâne pe serverul local) ---
# API OpenAI-compatible expus local de SGLang-Omni cu checkpointul exact:
# OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5
GUGUTA_MOSS_TTS_BASE_URL=http://host.docker.internal:8000
GUGUTA_MOSS_TTS_REFERENCE_AUDIO=/voices/romanian.wav
GUGUTA_MOSS_TTS_TIMEOUT_SECONDS=900
GUGUTA_PARAKEET_ASR_BASE_URL=http://host.docker.internal:8001
GUGUTA_PARAKEET_ASR_TIMEOUT_SECONDS=120
GUGUTA_PARAKEET_ASR_MAX_AUDIO_MIB=15
GUGUTA_AUDIO_OVERVIEW_MAX_OUTPUT_TOKENS=4096
GUGUTA_AUDIO_OVERVIEW_MAX_SOURCE_CHARS=60000
