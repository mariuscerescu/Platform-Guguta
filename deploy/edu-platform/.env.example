# ============================================================================
# Platforma Guguță — configurare de PRODUCȚIE (șablon)
# Publicare: https://tineri.math.md/edu-platform
#
# Copiază în `.env` (același director) și completează secretele.
# Fișierul `.env` NU se urcă în Git — `.gitignore` îl exclude.
# ============================================================================

# --- Mediu -------------------------------------------------------------------
# production: configurația refuză secretele de dev, originile http și
# furnizorii simulați (vezi open_notebook/database/guguta/config.py).
GUGUTA_ENVIRONMENT=production
GUGUTA_AUTH_MODE=password

# --- Publicare sub subcale ---------------------------------------------------
# Prefixul public. Se citește la BUILD (ajunge în bundle-ul de client),
# deci schimbarea lui cere `docker compose build frontend`, nu doar restart.
GUGUTA_BASE_PATH=/edu-platform
# Portul local pe care răspunde frontend-ul; nginx-ul gazdă trimite aici.
GUGUTA_HTTP_PORT=8300

# --- Origine publică / CORS --------------------------------------------------
# Doar origine (schemă + gazdă + port), FĂRĂ cale: browserul trimite exact atât
# în antetul `Origin`, iar API-ul respinge mutațiile cu cookie dacă nu se
# potrivește (403 origin_rejected).
GUGUTA_PUBLIC_ORIGIN=https://tineri.math.md
GUGUTA_CORS_ORIGINS=["https://tineri.math.md"]

# --- Secrete de aplicație ----------------------------------------------------
# Semnează materialul CSRF/state. Minim 16 caractere, altfel API-ul refuză
# pornirea. Generează: openssl rand -base64 36
GUGUTA_SERVER_SECRET=
# Chei de criptare a credențialelor (JSON, id -> secret, minim 16 caractere).
# NU schimba `k1` după ce ai salvat credențiale: devin indescifrabile.
GUGUTA_CREDENTIAL_ENCRYPTION_KEYS={"k1": ""}

# --- Parolele rolurilor PostgreSQL (ADR-0007) --------------------------------
# Roluri separate: migrator (schemal), api (runtime), worker (joburi).
# Se aplică la PRIMA pornire cu volum gol; ulterior le schimbi manual cu
# ALTER ROLE ... PASSWORD în containerul `db`.
GUGUTA_PG_MIGRATOR_PASSWORD=
GUGUTA_PG_API_PASSWORD=
GUGUTA_PG_WORKER_PASSWORD=

# --- Stocare privată (volum Docker `guguta_storage`) -------------------------
GUGUTA_STORAGE_ROOT=/data/guguta_storage

# --- Furnizori AI (L4/L5) ----------------------------------------------------
GUGUTA_CHAT_PROVIDER=openrouter
# Pentru Google direct, setează GUGUTA_CHAT_PROVIDER=gemini și cheia de mai jos.
GUGUTA_GEMINI_API_KEY=
GUGUTA_GEMINI_CHAT_MODEL=gemini-3.8-flash
GUGUTA_GEMINI_THINKING_LEVEL=medium
GUGUTA_CHAT_AGENT_ENABLED=false
GUGUTA_CHAT_AGENT_MAX_ROUNDS=4
GUGUTA_CHAT_AGENT_MAX_TOOL_CALLS=8
GUGUTA_CHAT_AGENT_MAX_IMAGES=6
GUGUTA_EMBEDDING_PROVIDER=local
# Qwen3-Embedding-0.6B produce vectori normalizați de 1024 dimensiuni.
GUGUTA_EMBEDDING_DIMENSION=1024
GUGUTA_RERANK_PROVIDER=local
GUGUTA_OPENROUTER_API_KEY=
GUGUTA_OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
GUGUTA_LOCAL_RETRIEVAL_BASE_URL=http://qwen-retrieval:8002
GUGUTA_LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
GUGUTA_LOCAL_EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
GUGUTA_LOCAL_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
GUGUTA_LOCAL_RERANK_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473
GUGUTA_LOCAL_RETRIEVAL_TIMEOUT_SECONDS=120
GUGUTA_OPENROUTER_TIMEOUT_SECONDS=240
GUGUTA_OPENROUTER_MAX_RETRIES=3
GUGUTA_OPENROUTER_MAX_OUTPUT_TOKENS=3000
# Doar endpointuri ZDR, data_collection=deny și cache de răspuns dezactivat.
# Aceste restricții sunt obligatorii în client, inclusiv la retry/fallback.
GUGUTA_OPENROUTER_PROVIDER_SORT=throughput
GUGUTA_OPENROUTER_INTERACTIVE_PROVIDER_SORT=latency
# Preferințe soft: secunde până la primul token și tokenuri/secundă.
GUGUTA_OPENROUTER_PREFERRED_MAX_LATENCY_SECONDS=3
GUGUTA_OPENROUTER_PREFERRED_MIN_THROUGHPUT=50
# În contul OpenRouter: Input & Output Logging și Use of Inputs/Outputs OFF.
# ZDR permite cache temporar în RAM la provider; vezi ADR-018.
GUGUTA_CHAT_TOTAL_TIMEOUT_SECONDS=300

# --- Voce romaneasca privata (MOSS-TTS) ------------------------------------
# Directorul contine mediul `.venv`, `models/` si scripturile MOSS validate.
GUGUTA_MOSS_TTS_RUNTIME_ROOT=/opt/moss-tts
# Fisier local pe gazda; este montat read-only si nu se salveaza in Git.
GUGUTA_MOSS_TTS_REFERENCE_AUDIO_HOST=/opt/moss-tts/reference/romanian.wav
GUGUTA_MOSS_TTS_BASE_URL=http://moss-tts:8000
GUGUTA_MOSS_TTS_REFERENCE_AUDIO=/voices/romanian.wav
GUGUTA_MOSS_TTS_GPU=1
GUGUTA_MOSS_TTS_TIMEOUT_SECONDS=900
GUGUTA_AUDIO_OVERVIEW_MAX_OUTPUT_TOKENS=4096
GUGUTA_AUDIO_OVERVIEW_MAX_SOURCE_CHARS=60000

# --- Dictare romaneasca privata (Parakeet ASR / NVIDIA NeMo) ---------------
# Directorul contine mediul `.venv` cu PyTorch CUDA si `nemo_toolkit[asr]`.
GUGUTA_PARAKEET_ASR_RUNTIME_ROOT=/opt/parakeet-asr
GUGUTA_PARAKEET_ASR_GPU=0
GUGUTA_PARAKEET_ASR_TIMEOUT_SECONDS=120
GUGUTA_PARAKEET_ASR_MAX_AUDIO_MIB=15

# Runtime Python 3.12 cu torch>=2.8 și transformers>=4.51; poate fi același
# runtime validat pentru Parakeet, deoarece serviciile sunt procese izolate.
GUGUTA_QWEN_RETRIEVAL_RUNTIME_ROOT=/opt/qwen-retrieval
GUGUTA_QWEN_RETRIEVAL_GPU=0

# --- PDF OCR: LiteParse + PP-OCRv5 Mobile local pe GPU -----------------------
GUGUTA_PDF_PARSER=liteparse_ppocr
GUGUTA_PPOCR_GPU=1
GUGUTA_PPOCR_MIN_CONFIDENCE=0.35
GUGUTA_PPOCR_TIMEOUT_SECONDS=120
GUGUTA_LITEPARSE_TIMEOUT_SECONDS=120
GUGUTA_PDF_OCR_DPI=120
GUGUTA_PDF_OCR_EVERY_PAGE=true
GUGUTA_PDF_OCR_COMPLEX_LAYOUT=false
GUGUTA_PDF_OCR_RENDER_BATCH_PAGES=10
GUGUTA_PDF_OCR_CONCURRENCY=10

# --- Limite de lucru (GHID §10.2) -------------------------------------------
GUGUTA_MAX_UPLOAD_MIB=25
GUGUTA_MAX_PDF_PAGES=300
GUGUTA_MAX_SOURCES_PER_NOTEBOOK=20
GUGUTA_QUOTA_MIB_PER_USER=1024
GUGUTA_MAX_CONCURRENT_JOBS_PER_USER=2

# --- Bază de date (pool) -----------------------------------------------------
GUGUTA_DB_POOL_SIZE=5
GUGUTA_DB_MAX_OVERFLOW=10
GUGUTA_DB_POOL_TIMEOUT_SECONDS=30

# --- PlayQuiz extern (ADR-023) ----------------------------------------------
# Export de quiz + cont automat către play-quiz.com, server-la-server.
# Lăsate goale, butonul „Deschide în PlayQuiz” nu apare. Cheia o emite PlayQuiz.
GUGUTA_PLAYQUIZ_API_URL=
GUGUTA_PLAYQUIZ_PARTNER_KEY=
GUGUTA_PLAYQUIZ_HMAC_SECRET=
GUGUTA_PLAYQUIZ_CATEGORY=guguta
GUGUTA_PLAYQUIZ_TIMEOUT_SECONDS=10
